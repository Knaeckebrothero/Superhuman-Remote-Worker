{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Superhuman Remote Worker Helm values",
  "description": "Phase 1 structural validation: types and enums for high-signal fields. Intentionally permissive (additionalProperties allowed) so forward-compatible keys and existing values overlays are not rejected. Cross-field semantics (internal/external requirements, license acceptance, nats mutual-exclusion, neo4j enterprise license) stay in template `required`/`fail` guards.",
  "type": "object",
  "required": ["license", "global"],
  "definitions": {
    "labelSelector": {
      "type": "object",
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": {
                "type": "string",
                "enum": ["In", "NotIn", "Exists", "DoesNotExist"]
              },
              "values": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": ["operator"],
                  "properties": { "operator": { "enum": ["In", "NotIn"] } }
                },
                "then": {
                  "required": ["values"],
                  "properties": { "values": { "minItems": 1 } }
                }
              },
              {
                "if": {
                  "required": ["operator"],
                  "properties": {
                    "operator": { "enum": ["Exists", "DoesNotExist"] }
                  }
                },
                "then": {
                  "properties": { "values": { "maxItems": 0 } }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "nonEmptyLabelSelector": {
      "allOf": [
        { "$ref": "#/definitions/labelSelector" },
        {
          "anyOf": [
            {
              "required": ["matchLabels"],
              "properties": { "matchLabels": { "minProperties": 1 } }
            },
            {
              "required": ["matchExpressions"],
              "properties": { "matchExpressions": { "minItems": 1 } }
            }
          ]
        }
      ]
    }
  },
  "properties": {
    "license": {
      "type": "object",
      "properties": {
        "acceptTerms": { "type": "boolean" }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "opencloud": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "nextcloud": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "livePreview": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "deniedPorts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "uniqueItems": true
            },
            "viewer": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "deploymentProfile": {
                  "type": "string",
                  "enum": ["development", "production"]
                },
                "cookieMode": {
                  "type": "string",
                  "enum": ["", "development-cookie-free", "psl-isolated"]
                },
                "domain": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^$|^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                },
                "hostSuffix": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^$|^\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                },
                "cockpitOrigins": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$"
                  },
                  "uniqueItems": true
                },
                "rawPathVerified": { "type": "boolean" },
                "pslBoundaryVerified": { "type": "boolean" },
                "sessionTtlSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 3600
                },
                "bootstrapTtlSeconds": {
                  "type": "integer",
                  "minimum": 15,
                  "maximum": 300
                },
                "attachmentTtlSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 7200
                },
                "revalidateSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15
                },
                "replicas": { "type": "integer", "minimum": 1, "maximum": 20 },
                "database": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string",
                      "pattern": "^[a-z_][a-z0-9_]{0,62}$"
                    },
                    "credentials": {
                      "type": "object",
                      "properties": {
                        "create": { "type": "boolean" },
                        "existingSecret": {
                          "type": "string",
                          "maxLength": 253,
                          "pattern": "^$|^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$"
                        },
                        "usernameKey": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._-]+$"
                        },
                        "passwordKey": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._-]+$"
                        }
                      },
                      "additionalProperties": false
                    },
                    "provisionRole": { "type": "boolean" },
                    "pool": {
                      "type": "object",
                      "properties": {
                        "min": { "type": "integer", "minimum": 1, "maximum": 16 },
                        "max": { "type": "integer", "minimum": 1, "maximum": 16 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "maxConnections": { "type": "integer", "minimum": 1, "maximum": 4096 },
                    "maxHttpPerSession": { "type": "integer", "minimum": 1, "maximum": 128 },
                    "maxHeaderBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
                    "maxHeaderFields": { "type": "integer", "minimum": 10, "maximum": 1000 },
                    "maxQueryBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
                    "maxQueryFields": { "type": "integer", "minimum": 1, "maximum": 1024 },
                    "maxRequestBodyBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
                    "maxResponseBodyBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
                    "connectTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
                    "idleTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
                    "exchangeTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 900 }
                  }
                },
                "networkPolicy": {
                  "type": "object",
                  "properties": {
                    "edgeNamespaceSelector": {
                      "$ref": "#/definitions/labelSelector"
                    },
                    "edgePodSelector": {
                      "$ref": "#/definitions/labelSelector"
                    },
                    "extraEgress": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  },
                  "then": {
                    "required": [
                      "deploymentProfile",
                      "cookieMode",
                      "domain",
                      "hostSuffix",
                      "cockpitOrigins",
                      "rawPathVerified",
                      "networkPolicy",
                      "database"
                    ],
                    "properties": {
                      "cookieMode": {
                        "enum": ["development-cookie-free", "psl-isolated"]
                      },
                      "domain": { "minLength": 4 },
                      "hostSuffix": { "minLength": 5 },
                      "cockpitOrigins": { "minItems": 1 },
                      "rawPathVerified": { "const": true },
                      "database": {
                        "required": ["username", "credentials", "provisionRole", "pool"],
                        "properties": {
                          "credentials": {
                            "required": ["create", "existingSecret", "usernameKey", "passwordKey"]
                          },
                          "pool": { "required": ["min", "max"] }
                        }
                      },
                      "networkPolicy": {
                        "required": [
                          "edgeNamespaceSelector",
                          "edgePodSelector"
                        ],
                        "properties": {
                          "edgeNamespaceSelector": {
                            "$ref": "#/definitions/nonEmptyLabelSelector"
                          },
                          "edgePodSelector": {
                            "$ref": "#/definitions/nonEmptyLabelSelector"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "enabled": { "const": true },
                      "deploymentProfile": { "const": "production" }
                    },
                    "required": ["enabled", "deploymentProfile"]
                  },
                  "then": {
                    "properties": {
                      "cookieMode": { "const": "psl-isolated" },
                      "pslBoundaryVerified": { "const": true },
                      "database": {
                        "properties": {
                          "credentials": {
                            "properties": {
                              "create": { "const": false },
                              "existingSecret": { "minLength": 1 }
                            }
                          },
                          "provisionRole": { "const": false }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "nats": {
      "type": "object",
      "properties": {
        "internal": { "type": "boolean" }
      }
    },
    "databases": {
      "type": "object",
      "properties": {
        "neo4j": {
          "type": "object",
          "properties": {
            "edition": { "type": "string", "enum": ["community", "enterprise"] }
          }
        }
      }
    },
    "vmController": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "transport": { "type": "string", "enum": ["http", "nats", "both"] }
      }
    },
    "garage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "storageClass": { "type": "string" },
        "dataStorageSize": { "type": "string" },
        "capacityBytes": { "type": "integer", "minimum": 1 },
        "buckets": {
          "type": "object",
          "properties": { "workspaces": { "type": "string" } }
        },
        "bootstrap": {
          "type": "object",
          "properties": { "image": { "type": "string" } }
        }
      }
    }
  }
}
