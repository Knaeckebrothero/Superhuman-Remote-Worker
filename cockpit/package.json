{
  "name": "cockpit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "prebuild": "node scripts/copy-monaco.mjs",
    "prestart": "node scripts/copy-monaco.mjs",
    "prewatch": "node scripts/copy-monaco.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:styles": "stylelint 'src/**/*.scss'",
    "i18n:check": "node scripts/check-i18n-parity.mjs && node scripts/check-i18n-hardcoded.mjs",
    "i18n:check:parity": "node scripts/check-i18n-parity.mjs",
    "i18n:check:hardcoded": "node scripts/check-i18n-hardcoded.mjs",
    "serve:ssr:cockpit": "node dist/cockpit/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-server": "^21.2.17",
    "@angular/pwa": "^21.2.8",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "@angular/ssr": "^21.2.7",
    "@jsverse/transloco": "^8.3.0",
    "@jsverse/transloco-locale": "^8.3.0",
    "@monaco-editor/loader": "^1.7.0",
    "angular-split": "^20.0.0",
    "clipboard": "^2.0.11",
    "cron-parser": "^4.9.0",
    "cronstrue": "^2.50.0",
    "cytoscape": "^3.33.1",
    "cytoscape-fcose": "^2.2.0",
    "dexie": "^4.2.1",
    "express": "^5.1.0",
    "marked": "^17.0.3",
    "monaco-editor": "^0.55.1",
    "ngx-markdown": "^21.1.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.17",
    "@types/cytoscape": "^3.21.9",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/prismjs": "^1.26.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.1.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "undici": "^7.24.5",
    "picomatch": "^4.0.4",
    "vite": "^7.3.5",
    "ws": "^8.21.0",
    "@babel/core": "^7.29.7"
  }
}
