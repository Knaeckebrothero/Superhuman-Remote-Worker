# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Self-hosted GitHub Actions runner image for Superhuman Remote Worker CI.
#
# Two targets:
#   base  -> general CI (lint, tests, docker builds, helm, db-migrations)
#   kvm   -> base + QEMU/OVMF for the Packer VM-image jobs, scheduled onto the
#            privileged scale set that exposes /dev/kvm
#
# Built ONLY on ubuntu-latest (.github/workflows/ci-runner-image.yml). Building
# it on a self-hosted runner would be a bootstrap cycle: a bad push would mean
# the fix could not be built. scripts/check_ci_runners.py enforces that pin.
#
# RUNNER_VERSION tracks whatever the ARC chart ships (0.14.2 -> 2.334.0). Keeping
# them equal avoids ARC's version-skew warning; bump both together.
#
# Almost everything installed here exists because some job silently assumed
# ubuntu-latest provided it. Those assumptions are invisible until they break,
# and one of them — yq in develop.yml's `changes` job — fails OPEN rather than
# loudly, silently forcing every VM image to rebuild on every run. See
# docs/ci_self_hosted_runners.md.
# ---------------------------------------------------------------------------
ARG RUNNER_VERSION=2.334.0
FROM ghcr.io/actions/actions-runner:${RUNNER_VERSION} AS base

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# --- 1. base OS packages ---------------------------------------------------
# Slow-changing, so first: this is the layer worth caching.
#
#   sudo              every "Free disk space" / "Install QEMU" / `sudo tee` step,
#                     and `npx playwright install --with-deps` shells out to apt
#   build-essential   gcc for vm/sudo-plugin/sudo_gate.c (develop.yml:1385,
#                     main.yml:831) and for any Python sdist that needs a compiler
#   postgresql-client psql at db-migrations.yml:163 — that job installs no client
#   jq                the job-started guard's payload cross-check uses it
#   curl/wget/tar/unzip/xz-utils
#                     assumed ambient by checkout, setup-*, squawk, kubeconform,
#                     yq installs, and the Ubuntu cloud-image download
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg lsb-release \
      git git-lfs openssh-client rsync \
      sudo build-essential pkg-config \
      python3 python3-venv python3-dev python3-pip \
      postgresql-client \
      jq unzip zip tar xz-utils bzip2 file locales tzdata procps less \
      libssl-dev libffi-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# --- 2. passwordless sudo for the runner user ------------------------------
# The upstream image already grants this via the `sudo` group, but that depends
# on an upstream choice we do not control and every disk-freeing and apt step in
# the pipeline breaks without it. An explicit sudoers drop-in is cheap insurance;
# `visudo -c` fails the build rather than shipping an image that cannot escalate.
RUN echo 'runner ALL=(ALL:ALL) NOPASSWD:ALL' > /etc/sudoers.d/99-runner \
    && chmod 0440 /etc/sudoers.d/99-runner \
    && visudo -c

# --- 3. docker CLI + buildx + compose --------------------------------------
# CLI only, no daemon: ARC's dind sidecar provides dockerd and the runner reaches
# it over the shared /var/run/docker.sock. Installing docker-ce would drag in
# containerd and a systemd unit that never starts.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
       | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] \
https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       docker-ce-cli docker-buildx-plugin docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# --- 4. Node ---------------------------------------------------------------
# setup-node@v4 pins 22 in the workflows and brings its own, which wins on PATH.
# This copy is for image-build time (the Playwright dep pass below) and as a
# floor for anything shelling out to node/npx without a setup-node step first.
ARG NODE_MAJOR=22
RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- 5. Playwright system libraries ----------------------------------------
# test-cockpit runs `npx playwright install --with-deps chromium firefox webkit`,
# which apt-installs ~100 packages. Pre-satisfying them turns a two-minute apt
# transaction into a no-op. The list is NOT hand-maintained — Playwright is asked
# for it, so it stays correct as the pin moves.
#
# This layer is a CACHE, never a CONTRACT: `--with-deps` stays in the workflow so
# a .playwright-version bump self-heals against a stale image.
ARG PLAYWRIGHT_VERSION=1.59.0
RUN npx --yes "playwright@${PLAYWRIGHT_VERSION}" install-deps \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# --- 6. small pinned tools -------------------------------------------------
# yq:   develop.yml:678-679 uses it and says so in a comment. Its absence fails
#       OPEN — empty result -> has_changes reads "changed" -> EVERY VM job
#       rebuilds on EVERY run, silently and expensively. The workflow now also
#       hard-fails on a missing yq; this is the other half of that belt.
# helm: tests/test_canvas_slice3_infra.py does which("helm"), so on a runner
#       without it the chart contract tests silently SKIP instead of running.
# kubeconform: the chart jobs install it themselves; here for parity and speed.
ARG YQ_VERSION=v4.44.3
ARG HELM_VERSION=v3.17.0
ARG KUBECONFORM_VERSION=v0.6.7
RUN set -eux; \
    curl -fsSL -o /usr/local/bin/yq \
      "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64"; \
    chmod +x /usr/local/bin/yq; yq --version; \
    curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
      | tar -xz -C /tmp linux-amd64/helm; \
    install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm; rm -rf /tmp/linux-amd64; \
    helm version --short; \
    curl -fsSL "https://github.com/yannh/kubeconform/releases/download/${KUBECONFORM_VERSION}/kubeconform-linux-amd64.tar.gz" \
      | tar -xz -C /usr/local/bin kubeconform; \
    kubeconform -v

# --- 7. hosted-compatible tool cache ---------------------------------------
# setup-python / setup-node / setup-go / setup-packer write here. Matching the
# hosted path means a persistent volume can later be mounted over it, and it
# keeps the heavy "Free disk space" steps that delete /opt/hostedtoolcache
# meaningful for the case where the kill-switch sends a job back to hosted.
ENV AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache
RUN mkdir -p /opt/hostedtoolcache /opt/ci-cache \
    && chown -R runner:runner /opt/hostedtoolcache /opt/ci-cache

# --- 8. the fork guard -----------------------------------------------------
# THE structural control. Runs before the job's first step — before checkout —
# and lives in the image, so a pull request cannot edit, skip, or delete it.
# Everything in .github/workflows/ can be rewritten by a fork PR. This cannot.
# Mode 0555: readable and executable by the runner user, writable by nobody.
COPY --chown=root:root docker/ci-runner/job-started-guard.sh /opt/ci/job-started-guard.sh
RUN chmod 0555 /opt/ci/job-started-guard.sh
ENV ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/ci/job-started-guard.sh

USER runner

# ---------------------------------------------------------------------------
# kvm: the Packer VM-image jobs (build-agent-vm-base-stage1 / -base, and the
# weekly stage1-rebuild cron). Separate target so the general runner does not
# carry ~400 MB of QEMU it never executes.
#
# The jobs apt-get install these themselves, so this layer is a speed-up, not a
# contract — the same cache-not-contract rule as the Playwright layer. What the
# general image genuinely cannot do is reach /dev/kvm, and that is a pod-spec
# property (privileged + hostPath), not an image one.
# ---------------------------------------------------------------------------
FROM base AS kvm
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      qemu-system-x86 qemu-utils genisoimage ovmf cpu-checker \
    && rm -rf /var/lib/apt/lists/*
USER runner
