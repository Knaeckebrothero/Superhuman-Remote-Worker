# =============================================================================
# Universal Agent Dockerfile
# =============================================================================
#
# A unified Docker image for any agent configuration.
# The agent behavior is determined by the AGENT_CONFIG environment variable.
#
# Build:
#   docker build -t srw-agent -f docker/Dockerfile.agent .
#
# Run with defaults:
#   docker run -p 8001:8001 \
#     -e DATABASE_URL=postgresql://... \
#     -e OPENAI_API_KEY=... \
#     srw-agent
#
# Run with custom config:
#   docker run -p 8001:8001 \
#     -e AGENT_CONFIG=my_agent \
#     -e DATABASE_URL=postgresql://... \
#     -e OPENAI_API_KEY=... \
#     srw-agent
#
# Entry point: agent.py (Universal Agent CLI)
# =============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies (git needed for pip install from git URLs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch first (separate layer — rarely changes, ~200MB vs ~2GB with CUDA)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Optional: path to local CitationEngine source (for local builds)
ARG CITATION_ENGINE_PATH=""

COPY requirements.txt .

# When CITATION_ENGINE_PATH is set, exclude citation-engine from requirements
# (it will be installed separately from local source below)
RUN if [ -n "$CITATION_ENGINE_PATH" ]; then \
      sed '/citation-engine/d' requirements.txt > /tmp/reqs.txt && \
      pip install --no-cache-dir -r /tmp/reqs.txt; \
    else \
      pip install --no-cache-dir -r requirements.txt; \
    fi

# Copy local CitationEngine when building locally; falls back to copying
# requirements.txt (harmless no-op) so the COPY never fails in CI/CD builds
COPY ${CITATION_ENGINE_PATH:-requirements.txt} /tmp/citation_engine_src/
RUN if [ -n "$CITATION_ENGINE_PATH" ]; then \
      pip install --no-cache-dir "/tmp/citation_engine_src[full]"; \
    fi

# Production image
FROM python:3.11-slim

LABEL maintainer="SRW Team"
LABEL description="Universal Agent for document processing and requirement validation"

# Create non-root user early so COPY --chown can reference it
RUN groupadd -r srw && useradd -r -g srw -m srw

# Build SHA for stale-image detection (passed via --build-arg)
ARG BUILD_SHA=""

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    AGENT_CONFIG=defaults \
    AGENT_PORT=8001 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    BUILD_SHA=${BUILD_SHA}

WORKDIR /app

# Install curl first (needed for NodeSource setup), then add Node.js 22 repo
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && rm -rf /var/lib/apt/lists/*

# Install runtime + dev dependencies
# The container IS the agent's computer — full toolset available.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    poppler-utils \
    ffmpeg \
    ripgrep \
    jq \
    nodejs \
    build-essential \
    cmake \
    python3-dev \
    libffi-dev \
    vim-tiny \
    less \
    tree \
    htop \
    procps \
    net-tools \
    iproute2 \
    dnsutils \
    openssh-client \
    zip \
    unzip \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder (system-owned, read-only is fine)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Install Playwright chromium BEFORE source code (only rebuilds when playwright version changes)
RUN playwright install --with-deps chromium

# Copy source code LAST (changes most frequently, avoids busting playwright cache)
COPY --chown=srw:srw src/ ./src/
COPY --chown=srw:srw config/ ./config/
COPY --chown=srw:srw agent.py ./

# Marker so get_project_root() finds /app (no .git in container)
RUN touch /app/pyproject.toml && chown srw:srw /app/pyproject.toml

# Create runtime directories with correct ownership
RUN mkdir -p /app/workspace /app/logs && \
    chown -R srw:srw /app/workspace /app/logs

# User-writable package directories (pip/npm without sudo)
RUN mkdir -p /home/srw/.local/bin /home/srw/.local/lib/python3.11/site-packages \
             /home/srw/.npm-global /home/srw/.cache \
    && chown -R srw:srw /home/srw

ENV PIP_TARGET=/home/srw/.local/lib/python3.11/site-packages \
    PATH="/home/srw/.local/bin:/home/srw/.npm-global/bin:${PATH}" \
    npm_config_prefix=/home/srw/.npm-global

USER srw

# Expose default port (can be overridden)
EXPOSE 8001
EXPOSE 8002

# Health check using the configured port
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${AGENT_PORT}/health || exit 1

# Run the Universal Agent with config from environment
CMD ["sh", "-c", "python agent.py --config ${AGENT_CONFIG} --port ${AGENT_PORT} --host 0.0.0.0"]
