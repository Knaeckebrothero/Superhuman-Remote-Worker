# syntax=docker/dockerfile:1.7
# =============================================================================
# Universal Agent Dockerfile (Tilt dev variant)
# =============================================================================
#
# Why this exists vs docker/Dockerfile.agent (the prod image):
#
#   1. **BuildKit cache mounts on every download step.** Prod's Dockerfile
#      strips apt/pip caches at the end of each RUN ("--no-cache-dir",
#      "rm -rf /var/lib/apt/lists/*") to keep the published image small.
#      For dev iteration that's the wrong trade — the layer-cache miss
#      rate is ~100% on these instructions because pip/apt install
#      timestamps make the resulting layer non-deterministic, so on every
#      rebuild we'd re-download ~5 min of packages from PyPI / Debian /
#      playwright CDN. The fix is `RUN --mount=type=cache,...`: a
#      persistent build-side mount that survives layer invalidation. The
#      RUN layer still rebuilds, but the download is served from cache.
#      Final image is still small because the cache mount is NOT included
#      in the image.
#   2. **No HEALTHCHECK**: K8s probes own liveness/readiness in the dev
#      cluster; the dockerd-side HEALTHCHECK is redundant and just slows
#      pod startup.
#   3. **citation_engine lives under src/** (src/agent/citation_engine/, folded in
#      from its former separate repo): it's COPY'd as part of src/, so it's no
#      longer a dev/prod difference and edits rebuild in the normal loop.
#   4. **No BUILD_SHA stamping**: the Tilt loop tags `tilt-<hash>`, and
#      SHA-based drift detection (agent_manager.py) is intentionally a
#      no-op in dev.
#
# Layer ordering is identical to prod so the iteration loop hits Docker's
# layer cache for everything except `src/agent/`, `src/shared/`, `config/`, `pyproject.toml` — and Tilt's
# docker_build `only=` list pins watching to those.
#
# Live_update is intentionally not configured for the agent (agent pods
# have restartPolicy: Never and are baked-in per-job — see Non-goals in
# the tilt_inner_loop_dev.md design doc). Instead we rely on:
#   1. Tilt rebuilds + pushes srw-agent:tilt-<hash> on save.
#   2. helm_resource re-renders the chart's ConfigMap with the new tag.
#   3. Stakater Reloader (already in chart, reloader.stakater.com/auto=true
#      on the orchestrator Deployment) bounces the orchestrator.
#   4. AgentProvisioner re-reads PERSISTENT_AGENT_IMAGE at init time and
#      provisions the next agent pod with the new tag.
# =============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

# Build deps in a separate apt run so the cache mount can survive across
# unrelated source edits.
# `sharing=locked` because two parallel builds writing to the same apt
# state would race; the lock serialises them.
# We intentionally do NOT `rm -rf /var/lib/apt/lists/*` here — apt's
# package lists live in the cache mount, which is excluded from the
# image automatically.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git

# Pip cache mount: ~700 MB of CPU torch + dependency wheels. With the
# mount, a re-run only re-extracts site-packages; without it, a 37 s
# fresh download every rebuild.
# `pip install` (no `--no-cache-dir`) populates ~/.cache/pip which is
# the mount target.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.txt

# =============================================================================
# Runtime image
# =============================================================================
FROM python:3.11-slim

LABEL maintainer="SRW Team"
LABEL description="Universal Agent (Tilt dev image)"

ARG UV_VERSION="0.7.12"

RUN groupadd -r srw && useradd -r -g srw -m srw

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONSAFEPATH=1 \
    AGENT_CONFIG=defaults \
    AGENT_PORT=8001

WORKDIR /app

# NodeSource bootstrap — kept in its own layer because the curl|bash
# pattern is non-cacheable in interesting ways and we want the failure
# blast radius small.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash -

# Big runtime package set. With the cache mount, the rebuild path is
# "apt resolves dependency graph + installs from cache" — fast (~30 s on
# our box). Without the mount it's a fresh ~2 min download.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    git \
    poppler-utils \
    ffmpeg \
    ripgrep \
    jq \
    rclone \
    nodejs \
    build-essential \
    cmake \
    python3-dev \
    libffi-dev \
    vim-tiny \
    less \
    tree \
    htop \
    procps \
    net-tools \
    iproute2 \
    dnsutils \
    openssh-client \
    zip \
    unzip \
    tmux

# Match the production agent's MCP stdio runtime. node/npm/npx come from the
# NodeSource nodejs package above; uv provides the exact-pinned uvx launcher.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install "uv==${UV_VERSION}"

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Pre-bake the tiktoken vocab. On egress-restricted clusters (k3d) the lazy
# download fails with a ~4s SYNCHRONOUS DNS retry per token-count call, which
# blocks the event loop densely enough that 1s liveness probes time out and
# the kubelet kills healthy officer/session pods mid-turn (observed live,
# exit 137). Build hosts have internet; runtime only ever reads the cache.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
RUN mkdir -p /opt/tiktoken-cache && \
    python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" && \
    chmod -R a+rX /opt/tiktoken-cache

# No browser in the agent image — Chromium lives on the workspace image only
# (browser-exec daemon). See knowledge-base/knowledge/issues/remove_local_browser_fallback.md.

# Source code LAST — these COPYs are what Tilt's docker_build
# `only=` list pins to.
COPY --chown=srw:srw src/agent/ ./src/agent/
COPY --chown=srw:srw src/shared/ ./src/shared/
COPY --chown=srw:srw config/ ./config/
COPY --chown=srw:srw pyproject.toml ./

# Editable installation keeps imports at the source paths synchronized by Tilt.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-deps -e .

# Transitional image-only entry for old/new orchestrators and durable recycle
# targets that still launch `python agent.py`. Keep package resolution canonical;
# the repository has no agent.py shim. Remove only after that compatibility
# window (including rollback targets) has closed.
RUN printf '%s\n' 'import runpy' \
    'runpy.run_module("agent", run_name="__main__", alter_sys=True)' \
    > /app/agent.py

# Older orchestrators also invoke this preStop module name. Provide just this
# image-only namespace entry in system site-packages, with no src/__init__.py
# or api/__init__.py and no alias for the former application source tree.
RUN python - <<'SRW_TERMINATION_COMPAT'
from pathlib import Path
import sysconfig

legacy_dir = Path(sysconfig.get_path("purelib")) / "src" / "api"
legacy_dir.mkdir(parents=True, exist_ok=True)
(legacy_dir / "persistent_termination.py").write_text(
    'import runpy\n'
    'if __name__ == "__main__":\n'
    '    runpy.run_module("agent.api.persistent_termination", '
    'run_name="__main__", alter_sys=True)\n',
    encoding="utf-8",
)
SRW_TERMINATION_COMPAT

RUN mkdir -p /app/workspace /app/logs && \
    chown -R srw:srw /app/workspace /app/logs

RUN mkdir -p /home/srw/.local/bin /home/srw/.local/lib/python3.11/site-packages \
             /home/srw/.npm-global /home/srw/.cache \
    && chown -R srw:srw /home/srw

ENV PIP_TARGET=/home/srw/.local/lib/python3.11/site-packages \
    PATH="/home/srw/.local/bin:/home/srw/.npm-global/bin:${PATH}" \
    npm_config_prefix=/home/srw/.npm-global

USER srw

# Verify the image-only compatibility command and normal module command both
# resolve the installed package, including under the non-root runtime user.
RUN python -c "from pathlib import Path; import agent, sys; assert sys.flags.safe_path; assert Path(agent.__file__).resolve() == Path('/app/src/agent/__init__.py')" \
    && python /app/agent.py --help >/dev/null \
    && python -m agent --help >/dev/null

# Exercise the actual old module command as the runtime user. Mock both the
# sentinel and HTTP request so this build check cannot initiate a real drain.
RUN --network=none python - <<'SRW_TERMINATION_SMOKE'
import importlib.util
from pathlib import Path
import runpy
import sys
from unittest.mock import patch

canonical = "agent.api.persistent_termination"
canonical_file = importlib.util.find_spec(canonical).origin
seen = {}
sys.argv = ["src.api.persistent_termination", "--compatibility-smoke"]


def observe(frame, event, _arg):
    if event == "call" and frame.f_code.co_name == "main":
        if frame.f_code.co_filename == canonical_file:
            seen.update(
                file=frame.f_globals["__file__"],
                package=frame.f_globals["__package__"],
                argv=list(sys.argv),
            )


with patch.object(Path, "mkdir"), patch.object(Path, "touch"):
    with patch("urllib.request.urlopen") as request:
        request.return_value.__enter__.return_value.status = 200
        sys.setprofile(observe)
        try:
            runpy.run_module(
                "src.api.persistent_termination", run_name="__main__", alter_sys=True
            )
        except SystemExit as result:
            assert result.code == 0
        finally:
            sys.setprofile(None)
        request.assert_called_once()
assert seen == {
    "file": canonical_file,
    "package": "agent.api",
    "argv": [canonical_file, "--compatibility-smoke"],
}, seen
SRW_TERMINATION_SMOKE

EXPOSE 8001
EXPOSE 8002

CMD ["sh", "-c", "exec python -m agent --config ${AGENT_CONFIG} --port ${AGENT_PORT} --host 0.0.0.0"]
