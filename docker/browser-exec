# Shared-browser streaming (docs/features/shared_browser.md, Piece 1)
# ─────────────────────────────────────────────────────────────────────

# Loopback-only stream listener. Covered by sshd `PermitOpen 127.0.0.1:*`;
# never reachable from the pod/VM network — same posture as live-app ports.
STREAM_PORT = int(os.environ.get("BROWSER_EXEC_STREAM_PORT", "38801"))
STREAM_QUALITY = int(os.environ.get("BROWSER_EXEC_STREAM_QUALITY", "60"))
STREAM_MAX_WIDTH = int(os.environ.get("BROWSER_EXEC_STREAM_MAX_WIDTH", "1280"))
STREAM_MAX_HEIGHT = int(os.environ.get("BROWSER_EXEC_STREAM_MAX_HEIGHT", "720"))
STREAM_EVERY_NTH = int(os.environ.get("BROWSER_EXEC_STREAM_EVERY_NTH", "2"))
BATON_GRACE_S = float(os.environ.get("BROWSER_EXEC_BATON_GRACE", "30"))

# Framing: [4-byte BE length][1-byte type][payload]; length covers type+payload.
T_HELLO, T_FRAME, T_STATE, T_INPUT, T_CONTROL, T_ERROR = 1, 2, 3, 4, 5, 6
MAX_STREAM_FRAME = 8 * 1024 * 1024


def encode_stream_frame(ftype: int, payload: bytes) -> bytes:
    if len(payload) + 1 > MAX_STREAM_FRAME:
        raise ValueError(f"stream frame too large: {len(payload) + 1}")
    return struct.pack(">IB", len(payload) + 1, ftype) + payload


async def read_stream_frame(reader) -> tuple[int, bytes]:
    """Read one framed message from an asyncio StreamReader."""
    head = await reader.readexactly(4)
    (length,) = struct.unpack(">I", head)
    if not 1 <= length <= MAX_STREAM_FRAME:
        raise ValueError(f"bad stream frame length: {length}")
    body = await reader.readexactly(length)
    return body[0], body[1:]


def encode_frame_payload(header: dict, jpeg: bytes) -> bytes:
    """FRAME payload: [2-byte BE header length][header JSON][raw JPEG]."""
    header_json = json.dumps(header).encode()
    return struct.pack(">H", len(header_json)) + header_json + jpeg


def decode_frame_payload(payload: bytes) -> tuple[dict, bytes]:
    (header_length,) = struct.unpack(">H", payload[:2])
    return (
        json.loads(payload[2 : 2 + header_length].decode()),
        payload[2 + header_length :],
    )

# Vendored from src/tools/research/browser_security.py (the daemon cannot
# import agent code): same schemes/hosts policy for viewer-driven navigation.
_NAV_BLOCKED_HOSTNAMES = {"metadata.google.internal", "metadata.goog"}
_NAV_K8S_INTERNAL_RE = re.compile(
    r"\.(cluster\.local|svc|svc\.cluster\.local|pod|pod\.cluster\.local)$",
    re.IGNORECASE,
)


def validate_user_nav(url: str, files) -> str:
    """Validate a viewer-typed URL.

    file:// renders via LocalFileServer (agent parity), then the resulting URL
    passes the same checks as agent navigation.
    """
    if not url or not url.strip():
        raise ValueError("URL cannot be empty")
    url = url.strip()
    if urlparse(url).scheme == "file":
        url = files.url_for(url)
    parsed = urlparse(url)
    scheme = (parsed.scheme or "").lower()
    if not scheme:
        url = f"https://{url}"
        parsed = urlparse(url)
        scheme = "https"
    if scheme in {"javascript", "data", "file"}:
        raise ValueError(f"Blocked scheme: {scheme}://")
    if scheme not in ("http", "https"):
        raise ValueError(f"Unsupported scheme: {scheme}://")
    hostname = (parsed.hostname or "").lower()
    if not hostname:
        raise ValueError("URL has no hostname")
    if hostname in _NAV_BLOCKED_HOSTNAMES:
        raise ValueError(f"Blocked hostname: {hostname}")
    if _NAV_K8S_INTERNAL_RE.search(hostname):
        raise ValueError(f"Blocked K8s internal hostname: {hostname}")
    return url

# Agent actions refused while the user holds the baton. Reads (snapshot,
# screenshot) always pass; stream_info/shutdown are lifecycle, not driving.
MUTATING_ACTIONS = {"navigate", "click", "type", "select", "scroll", "back"}


class StreamHub:
    """Shared-browser stream state: viewers, baton, browser generation.

    Owned by the daemon; the single authority for who is driving. See
    docs/features/shared_browser.md (Piece 1).
    """

    def __init__(self) -> None:
        self.baton = "agent"
        self.generation = None
        self.token = None
        self.viewers: dict = {}
        self._next_viewer_id = 0
        self._auto_release = None
        self.state_extra = {"url": None, "title": None, "loading": False}
        self.viewport = {
            "width": STREAM_MAX_WIDTH,
            "height": STREAM_MAX_HEIGHT,
        }
        self.on_state_change = None

    def mint_generation(self, initial_baton=None) -> None:
        """Mint a new browser identity and hello token."""
        self.generation = str(uuid.uuid4())
        self.token = secrets.token_hex(32)
        if initial_baton in ("agent", "user"):
            self.baton = initial_baton

    def clear_generation(self) -> None:
        self.generation = None
        self.token = None

    def state_payload(self) -> dict:
        return {
            "generation": self.generation,
            "baton": self.baton,
            "viewport": self.viewport,
            **self.state_extra,
        }

    def take_baton(self) -> None:
        self._set_baton("user")

    def release_baton(self) -> None:
        self._set_baton("agent")

    def _set_baton(self, holder: str) -> None:
        if self.baton != holder:
            self.baton = holder
            self._notify()

    def _notify(self) -> None:
        if self.on_state_change is not None:
            self.on_state_change()

    def add_viewer(self, queue) -> int:
        if self._auto_release is not None:
            self._auto_release.cancel()
            self._auto_release = None
        viewer_id = self._next_viewer_id
        self._next_viewer_id += 1
        self.viewers[viewer_id] = queue
        return viewer_id

    def remove_viewer(self, viewer_id) -> None:
        self.viewers.pop(viewer_id, None)
        if not self.viewers and self.baton == "user":
            loop = asyncio.get_running_loop()
            self._auto_release = loop.call_later(
                BATON_GRACE_S, self._release_after_grace
            )

    def _release_after_grace(self) -> None:
        self._auto_release = None
        self.release_baton()

    def broadcast(self, frame: bytes) -> None:
        """Fan a pre-encoded frame to viewers; drop oldest for laggards."""
        for queue in self.viewers.values():
            if queue.full():
                try:
                    queue.get_nowait()
                except asyncio.QueueEmpty:
                    pass
            try:
                queue.put_nowait(frame)
            except asyncio.QueueFull:
                pass

    def shutdown_viewers(self, code: str) -> None:
        """Tell every viewer the browser is gone and stop its writer."""
        error_frame = encode_stream_frame(
            T_ERROR,
            json.dumps({"code": code, "message": "browser ended"}).encode(),
        )
        for queue in list(self.viewers.values()):
            # Viewer queues are bounded. Reserve room for both the terminal
            # ERROR and the close sentinel instead of risking a full queue
            # swallowing the sentinel.
            while queue.maxsize > 0 and queue.qsize() > queue.maxsize - 2:
                try:
                    queue.get_nowait()
                except asyncio.QueueEmpty:
                    break
            try:
                queue.put_nowait(error_frame)
                queue.put_nowait(None)
            except asyncio.QueueFull:
                # The stream server uses maxsize=4, but keep shutdown safe for
                # any smaller custom queue by prioritising the close sentinel.
                try:
                    queue.get_nowait()
                except asyncio.QueueEmpty:
                    pass
                try:
                    queue.put_nowait(None)
                except asyncio.QueueFull:
                    pass


def log(msg: str) -> None:
    """Diagnostics to stderr (never stdout — stdout is the JSON channel)."""
    print(f"[browser-exec] {msg}", file=sys.stderr, flush=True)


# ─────────────────────────────────────────────────────────────────────
# Local file rendering (file:// → loopback HTTP)
# ─────────────────────────────────────────────────────────────────────


class _QuietHandler(SimpleHTTPRequestHandler):
    """SimpleHTTPRequestHandler that logs through ``log`` (stderr, prefixed).

    The default handler writes access lines straight to stderr unprefixed. Route
    them through ``log`` instead so the daemon log stays greppable — the fetches
    a page makes (missing CSS, 404 assets) are the first thing you want when a
    mockup renders unstyled.
    """

    def log_message(self, fmt: str, *args) -> None:  # noqa: A003
        log("http " + (fmt % args))


class LocalFileServer:
    """Serves local files to the browser over a loopback HTTP listener.

    Why this exists: browser-use's security watchdog rejects any URL without a
    hostname *before* it consults ``allowed_domains``::

        # browser_use/browser/watchdogs/security_watchdog.py
        if parsed.scheme in ['data', 'blob']:
            return True
        host = parsed.hostname
        if not host:
            return False          # ← file:///... lands here, unconditionally

    So ``file://`` is refused on every workspace backend and no setting turns it
    off. Since every mockup an agent writes is a local file, the practical effect
    was that agents could not look at their own work — they'd conclude no
    renderer existed at all. See docs/issues/vm_workspace_missing_browser_exec.md.

    Why serve over HTTP instead of patching the watchdog: patching a vendored
    library's security control is fragile across upgrades, and browser-use is
    pinned but not frozen. Navigating to a real ``http://`` URL is the supported
    path and needs no patching.

    Why the root is bounded: a page served from ``http://127.0.0.1:<port>`` shares
    an origin with everything else under that port, so the served root is exactly
    what a rendered page could fetch and exfiltrate. Rooting at ``/`` would let
    any rendered HTML read the whole disk — strictly worse than ``file://``, which
    Chrome gives an opaque origin per document. So the root is the agent's own
    workspace: content the agent already controls, and which by policy holds no
    internal credentials (docs feedback: creds never in the workspace). Files
    outside the workspace fall back to their own directory.

    The listener binds 127.0.0.1 inside the workspace, so it stays within the
    same loopback boundary browser-exec exists to enforce — it is never reachable
    from the pod/VM network.
    """

    def __init__(self) -> None:
        self._servers: dict[str, tuple] = {}
        self._lock = threading.Lock()

    def _root_for(self, path: Path) -> Path:
        """Widest sanctioned directory containing ``path``."""
        for candidate in (SERVE_ROOT, WORKSPACE_DEFAULT):
            if not candidate:
                continue
            try:
                root = Path(candidate).resolve()
            except OSError:
                continue
            if root.is_dir() and path.is_relative_to(root):
                return root
        # Outside the workspace: expose only the file's own directory, so a
        # stray render can't turn into a filesystem-wide read.
        return path.parent

    def _port_for(self, root: Path) -> int:
        key = str(root)
        with self._lock:
            existing = self._servers.get(key)
            if existing is not None:
                return existing[1]
            handler = partial(_QuietHandler, directory=key)
            # Port 0 → kernel picks a free ephemeral port; bound to loopback only.
            httpd = ThreadingHTTPServer(("127.0.0.1", 0), handler)
            port = httpd.server_address[1]
            threading.Thread(target=httpd.serve_forever, daemon=True).start()
            self._servers[key] = (httpd, port)
            log(f"serving {root} on http://127.0.0.1:{port}/ (local file render)")
            return port

    def url_for(self, url: str) -> str:
        """Translate a ``file://`` URL to a served ``http://`` one. Others pass through."""
        parsed = urlparse(url)
        if parsed.scheme != "file":
            return url

        path = Path(unquote(parsed.path)).resolve()
        if not path.exists():
            raise ValueError(f"local file not found: {path}")
        if path.is_dir():
            raise ValueError(f"refusing to render a directory: {path}")

        root = self._root_for(path)
        port = self._port_for(root)
        served = f"http://127.0.0.1:{port}/{quote(path.relative_to(root).as_posix())}"
        if parsed.query:
            served += f"?{parsed.query}"
        if parsed.fragment:
            served += f"#{parsed.fragment}"
        log(f"file:// is blocked by browser-use — rendering via {served}")
        return served

    def close(self) -> None:
        with self._lock:
            for httpd, _ in self._servers.values():
                try:
                    httpd.shutdown()
                    httpd.server_close()
                except Exception:
                    pass
            self._servers.clear()


# ─────────────────────────────────────────────────────────────────────
# Daemon: holds the persistent browser-use session
# ─────────────────────────────────────────────────────────────────────


class BrowserDaemon:
    """Owns a single persistent ``BrowserSession`` and runs actions on it."""

    def __init__(self) -> None:
        self._session = None
        self._lock = asyncio.Lock()
        self.should_exit = False
        self._files = LocalFileServer()
        self.hub = StreamHub()

    async def _get_session(self):
        """Return a healthy BrowserSession, (re)starting Chromium if needed."""
        from browser_use import BrowserSession

        if self._session is not None:
            try:
                await self._session.get_current_page_url()
                return self._session
            except Exception:
                log("session unhealthy, restarting")
                await self._close_session()

        Path(PROFILE_DIR).mkdir(parents=True, exist_ok=True)
        # browser-use launches Chromium from the explicit executable_path below
        # (the agent-chromium symlink → Playwright's Chromium). Pinning the binary
        # keeps browser-use off its auto-detect/auto-install path. No CDP port, no
        # remote debugging. The workspace pod can't run Chromium's sandbox (no user
        # namespaces), so disable it and avoid /dev/shm + GPU — the same flags the
        # old _start_remote_chromium used.
        session = BrowserSession(
            headless=True,
            executable_path=CHROMIUM_PATH,
            user_data_dir=PROFILE_DIR,
            chromium_sandbox=False,
            args=["--no-sandbox", "--disable-dev-shm-usage", "--disable-gpu"],
        )
        await session.start()
        self._session = session
        log("Chromium session started")
        return session

    async def _close_session(self) -> None:
        if self._session is not None:
            try:
                await self._session.stop()
            except Exception:
                pass
            self._session = None
        self.hub.clear_generation()
        self.hub.shutdown_viewers("browser_gone")

    # ── action handlers (mirror browser_direct.py helpers) ──

    async def _page_state(self, session, args: dict) -> dict:
        # get_browser_state_summary builds the DOM, populates the selector map
        # (so get_element_by_index works for click/type/select), and captures a
        # screenshot — all in one call. (DomService.get_serialized_dom_tree does
        # NOT populate the session selector map, which breaks ref-based actions.)
        include_shot = bool(args.get("include_screenshot"))
        summary = await session.get_browser_state_summary(
            include_screenshot=include_shot
        )

        dom_text = summary.dom_state.llm_representation()
        max_chars = int(args.get("max_dom_chars", 40000))
        if len(dom_text) > max_chars:
            dom_text = dom_text[:max_chars] + "\n... (DOM truncated)"

        result: dict = {
            "url": summary.url,
            "title": summary.title,
            "dom": dom_text,
        }

        if include_shot and summary.screenshot:
            result["screenshot"] = summary.screenshot  # already base64

        try:
            tabs = summary.tabs
            if tabs and len(tabs) > 1:
                result["tabs"] = [
                    {
                        "id": getattr(t, "target_id", getattr(t, "id", None)),
                        "url": getattr(t, "url", None),
                        "title": getattr(t, "title", None),
                    }
                    for t in tabs
                ]
        except Exception:
            pass

        self.hub.state_extra["url"] = result["url"]
        self.hub.state_extra["title"] = result["title"]
        result["baton"] = self.hub.baton
        return result

    async def _click(self, session, ref: int) -> None:
        from browser_use.browser.events import ClickElementEvent

        node = await session.get_element_by_index(ref)
        if node is None:
            raise ValueError(
                f"Element ref={ref} not found. Use snapshot to get current refs."
            )
        event = session.event_bus.dispatch(ClickElementEvent(node=node))
        await event
        await event.event_result(raise_if_any=True)

    async def _type(self, session, ref: int, text: str, clear: bool = True) -> None:
        from browser_use.browser.events import TypeTextEvent

        node = await session.get_element_by_index(ref)
        if node is None:
            raise ValueError(
                f"Element ref={ref} not found. Use snapshot to get current refs."
            )
        event = session.event_bus.dispatch(
            TypeTextEvent(node=node, text=text, clear=clear)
        )
        await event
        await event.event_result(raise_if_any=True)

    async def _select(self, session, ref: int, value: str) -> None:
        from browser_use.browser.events import SelectDropdownOptionEvent

        node = await session.get_element_by_index(ref)
        if node is None:
            raise ValueError(
                f"Element ref={ref} not found. Use snapshot to get current refs."
            )
        # browser-use's SelectDropdownOptionEvent selects by the option's visible
        # text; the field is ``text`` (not ``option``). Passing the wrong kwarg
        # trips a pydantic "text Field required" error and the select never runs.
        event = session.event_bus.dispatch(
            SelectDropdownOptionEvent(node=node, text=value)
        )
        await event
        await event.event_result(raise_if_any=True)

    async def _scroll(
        self, session, direction: str, amount: int = 500, ref=None
    ) -> None:
        from browser_use.browser.events import ScrollEvent

        node = None
        if ref is not None:
            node = await session.get_element_by_index(ref)
        event = session.event_bus.dispatch(
            ScrollEvent(direction=direction, amount=amount, node=node)
        )
        await event
        # ScrollEvent's handler returns None (EventResult[NoneType]); the default
        # raise_if_none=True would reject a perfectly good scroll with "Expected at
        # least one handler to return a non-None result". Keep raise_if_any so real
        # handler exceptions still surface.
        await event.event_result(raise_if_any=True, raise_if_none=False)

    async def _back(self, session) -> None:
        page = await session.get_current_page()
        if page is not None:
            await page.evaluate("() => { window.history.back(); }")
            await asyncio.sleep(0.5)

    async def handle(self, req: dict) -> dict:
        """Dispatch one request to the live session. Always returns a dict."""
        action = req.get("action")
        args = req.get("args") or {}

        if action not in VALID_ACTIONS:
            return {"error": f"unknown action: {action!r}"}

        # While the user drives, refuse mutating agent actions up front:
        # never spawn Chromium and never take the action lock.
        if action in MUTATING_ACTIONS and self.hub.baton == "user":
            return {
                "error": "user_is_driving",
                "url": self.hub.state_extra.get("url"),
                "message": (
                    "The user is currently driving the shared browser. "
                    "Read-only actions (snapshot, screenshot) still work; "
                    "ask the user to release control before taking actions."
                ),
            }

        # Serialize: browser-use sessions are not concurrency-safe, and the
        # agent issues actions one at a time anyway.
        async with self._lock:
            try:
                if action == "shutdown":
                    await self._close_session()
                    self._files.close()
                    self.should_exit = True
                    return {"ok": True}

                session = await self._get_session()

                if action == "stream_info":
                    if self.hub.generation is None:
                        self.hub.mint_generation(args.get("initial_baton"))
                    return {
                        "generation": self.hub.generation,
                        "token": self.hub.token,
                        "port": STREAM_PORT,
                        "baton": self.hub.baton,
                    }
                if action == "navigate":
                    # file:// is blocked outright by browser-use's watchdog, so a
                    # local path is rendered through a loopback HTTP listener
                    # rooted at the workspace. Non-file URLs pass through
                    # untouched. See LocalFileServer.
                    await session.navigate_to(self._files.url_for(args["url"]))
                    return await self._page_state(session, args)
                if action == "snapshot":
                    return await self._page_state(session, args)
                if action == "screenshot":
                    shot = await session.take_screenshot()
                    url = await session.get_current_page_url()
                    title = await session.get_current_page_title()
                    self.hub.state_extra["url"] = url
                    self.hub.state_extra["title"] = title
                    return {
                        "url": url,
                        "title": title,
                        "screenshot": base64.b64encode(shot).decode(),
                        "baton": self.hub.baton,
                    }
                if action == "click":
                    await self._click(session, int(args["ref"]))
                    return await self._page_state(session, args)
                if action == "type":
                    await self._type(
                        session,
                        int(args["ref"]),
                        args.get("text", ""),
                        clear=bool(args.get("clear", True)),
                    )
                    return await self._page_state(session, args)
                if action == "select":
                    await self._select(session, int(args["ref"]), args["value"])
                    return await self._page_state(session, args)
                if action == "scroll":
                    ref = args.get("ref")
                    await self._scroll(
                        session,
                        args.get("direction", "down"),
                        int(args.get("amount", 500)),
                        int(ref) if ref is not None else None,
                    )
                    return await self._page_state(session, args)
                if action == "back":
                    await self._back(session)
                    return await self._page_state(session, args)
            except KeyError as e:
                return {"error": f"{action}: missing required argument {e}"}
            except Exception as e:
                return {"error": f"{action} failed: {e}"}

        return {"error": f"unhandled action: {action}"}


# ─────────────────────────────────────────────────────────────────────
# Daemon server (unix socket, newline-delimited JSON: one req/resp per conn)
# ─────────────────────────────────────────────────────────────────────


async def _serve() -> int:
    daemon = BrowserDaemon()

    async def on_conn(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
        try:
            line = await reader.readline()
            if not line:
                return
            req = json.loads(line.decode())
            resp = await daemon.handle(req)
            writer.write(json.dumps(resp).encode() + b"\n")
            await writer.drain()
        except Exception as e:
            try:
                writer.write(json.dumps({"error": f"daemon error: {e}"}).encode() + b"\n")
                await writer.drain()
            except Exception:
                pass
        finally:
            try:
                writer.close()
            except Exception:
                pass
            if daemon.should_exit:
                # graceful shutdown after responding to a 'shutdown' request
                asyncio.get_event_loop().call_soon(_stop_server)

    stop_event = asyncio.Event()

    def _stop_server():
        stop_event.set()

    # Stale socket cleanup; bail out if another daemon already owns it.
    if os.path.exists(SOCKET_PATH):
        if _ping(SOCKET_PATH):
            log("another daemon is already running; exiting")
            return 0
        try:
            os.unlink(SOCKET_PATH)
        except OSError:
            pass

    server = await asyncio.start_unix_server(on_conn, path=SOCKET_PATH)
    try:
        os.chmod(SOCKET_PATH, 0o600)
    except OSError:
        pass
    log(f"listening on {SOCKET_PATH}")
    async with server:
        await stop_event.wait()
    log("shutting down")
    try:
        os.unlink(SOCKET_PATH)
    except OSError:
        pass
    return 0


def _ping(path: str) -> bool:
    """True if a daemon is accepting connections on the socket."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1.0)
            s.connect(path)
        return True
    except OSError:
        return False


# ─────────────────────────────────────────────────────────────────────
# Client
# ─────────────────────────────────────────────────────────────────────


def _spawn_daemon() -> None:
    """Start the daemon detached, logging to DAEMON_LOG."""
    Path(DAEMON_LOG).parent.mkdir(parents=True, exist_ok=True)
    log_fh = open(DAEMON_LOG, "a")
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "serve"],
        stdout=log_fh,
        stderr=log_fh,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )


def _request(req: bytes, timeout: float) -> bytes:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(SOCKET_PATH)
        s.sendall(req)
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return buf


def run_client(action: str, args: dict, timeout: float) -> int:
    """Send one action; print the JSON reply to stdout. Returns exit code."""
    req = json.dumps({"action": action, "args": args}).encode() + b"\n"

    last_err = None
    for attempt in range(12):  # ~ up to 6s of daemon spin-up
        try:
            resp = _request(req, timeout)
            sys.stdout.write(resp.decode().rstrip("\n") + "\n")
            return 0
        except (ConnectionRefusedError, FileNotFoundError, OSError) as e:
            last_err = e
            if attempt == 0:
                log("daemon not running, spawning")
                _spawn_daemon()
            import time

            time.sleep(0.5)

    print(json.dumps({"error": f"could not reach browser-exec daemon: {last_err}"}))
    return 1


# ─────────────────────────────────────────────────────────────────────
# Entrypoint
# ─────────────────────────────────────────────────────────────────────


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="browser-exec")
    parser.add_argument("action", help="serve | " + " | ".join(sorted(VALID_ACTIONS)))
    parser.add_argument("--json", default="{}", help="JSON-encoded action arguments")
    parser.add_argument(
        "--timeout", type=float, default=180.0, help="client socket timeout (s)"
    )
    ns = parser.parse_args(argv)

    if ns.action == "serve":
        try:
            return asyncio.run(_serve())
        except KeyboardInterrupt:
            return 0

    try:
        args = json.loads(ns.json)
        if not isinstance(args, dict):
            raise ValueError("--json must encode an object")
    except ValueError as e:
        print(json.dumps({"error": f"bad --json: {e}"}))
        return 1

    return run_client(ns.action, args, ns.timeout)


if __name__ == "__main__":
    sys.exit(main())
