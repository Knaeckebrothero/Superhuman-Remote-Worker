[Unit]
Description=Sudo Approval Gate Daemon Socket
Documentation=https://github.com/Knaeckebrothero/Superhuman-Remote-Worker

[Socket]
ListenStream=/run/sudo-gated/sudo-gated.sock
SocketMode=0660
SocketUser=root
SocketGroup=sudo-gated
DirectoryMode=0775

# Queue up to 5 connections while daemon starts
Backlog=5

[Install]
WantedBy=sockets.target
