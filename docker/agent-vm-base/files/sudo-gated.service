[Unit]
Description=Sudo Approval Gate Daemon
Documentation=https://github.com/Knaeckebrothero/Superhuman-Remote-Worker
Requires=sudo-gated.socket
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/sudo-gated --config /etc/sudo-gate/config.yaml
Restart=always
RestartSec=5
WatchdogSec=30
EnvironmentFile=/etc/default/sudo-gated

# Run as dedicated service user
User=sudo-gated
Group=sudo-gated

# Hardening — daemon only needs Unix socket + NATS TCP
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/sudo-gated

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sudo-gated

[Install]
WantedBy=multi-user.target
