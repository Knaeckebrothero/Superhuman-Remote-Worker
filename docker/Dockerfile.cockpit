# =============================================================================
# Cockpit Frontend Dockerfile
# =============================================================================
#
# Static Angular application served via nginx.
#
# Build:
#   docker build -t srw-cockpit -f docker/Dockerfile.cockpit .
#
# Run:
#   docker run -p 4000:4000 srw-cockpit
# =============================================================================

FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY cockpit/package.json cockpit/package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY cockpit/tsconfig.json cockpit/tsconfig.app.json cockpit/angular.json cockpit/ngsw-config.json ./
COPY cockpit/src/ ./src/
COPY cockpit/public/ ./public/

# Build the Angular application (static output)
RUN npm run build

# Production image
FROM nginx:alpine

LABEL maintainer="SRW Team"
LABEL description="Cockpit Angular Frontend"

# Copy built static assets from builder
COPY --from=builder /app/dist/cockpit/browser /usr/share/nginx/html

# Nginx config: SPA fallback + port 4000
RUN printf 'server {\n\
    listen 4000;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:4000/ || exit 1
