# =============================================================================
# Cockpit Frontend Dockerfile
# =============================================================================
#
# Static Angular application served via nginx.
#
# Build:
#   docker build -t srw-cockpit -f docker/Dockerfile.cockpit .
#
# Run:
#   docker run -p 4000:4000 srw-cockpit
# =============================================================================

FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY cockpit/package.json cockpit/package-lock.json ./

# Install dependencies — BuildKit cache mount on /root/.npm survives across
# RUNs in this build (and helps when this layer is busted but cache survives).
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Copy source code
COPY cockpit/tsconfig.json cockpit/tsconfig.app.json cockpit/angular.json cockpit/ngsw-config.json ./
COPY cockpit/src/ ./src/
COPY cockpit/public/ ./public/
# scripts/ holds prebuild helpers (e.g. copy-monaco.mjs) that npm runs via
# the `prebuild` hook when `npm run build` fires. Without this COPY the
# Docker build fails at `MODULE_NOT_FOUND scripts/copy-monaco.mjs`.
COPY cockpit/scripts/ ./scripts/

# Build the Angular application (static output)
RUN npm run build

# Production image
FROM nginx:alpine

LABEL maintainer="SRW Team"
LABEL description="Cockpit Angular Frontend"

# Copy built static assets from builder
COPY --from=builder /app/dist/cockpit/browser /usr/share/nginx/html

# Compose can inject the non-secret Canvas viewer suffix at container start.
# The stock nginx entrypoint runs executable scripts in /docker-entrypoint.d;
# Helm instead mounts a complete chart-rendered env.js and leaves this unset.
COPY docker/cockpit-canvas-env.sh /docker-entrypoint.d/40-srw-canvas-env.sh
RUN chmod 0755 /docker-entrypoint.d/40-srw-canvas-env.sh

# Nginx config: SPA fallback, PWA manifest type, and trusted-parent
# anti-framing headers. Keep it as a normal config file so the exact security
# header values can be reviewed and regression-tested without shell escaping.
COPY docker/cockpit-nginx.conf /etc/nginx/conf.d/default.conf
RUN nginx -t

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:4000/ || exit 1
