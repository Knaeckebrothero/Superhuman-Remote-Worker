{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverTheBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::srw-pgbackup"
      ]
    },
    {
      "Sid": "ListWithinTheReleasePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::srw-pgbackup"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "dev/*",
            "dev"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteObjectsUnderThePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::srw-pgbackup/dev/*"
      ]
    }
  ]
}
